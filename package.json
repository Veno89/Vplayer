{
  "name": "vplayer",
  "version": "0.9.51",
  "description": "Fast, lightweight, and fully customizable music player for your desktop",
  "type": "module",
  "author": "Veno",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Veno89/Vplayer.git"
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=12.0.2 <13"
  },
  "packageManager": "npm@12.0.2",
  "private": true,
  "scripts": {
    "dev": "vite",
    "tauri": "tauri",
    "pretauri:dev": "npm run check:toolchains",
    "tauri:dev": "tauri dev",
    "test": "vitest run --pool=threads --maxWorkers=1 --no-file-parallelism",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project tsconfig.node.json",
    "check:versions": "node scripts/check-version.mjs",
    "check:toolchains": "node scripts/check-toolchains.mjs",
    "verify:frontend": "npm run check:toolchains && npm run typecheck && npm test && npm run build",
    "build": "vite build",
    "tauri:build": "tauri build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-window": "^2.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
