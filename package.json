{
  "name": "vplayer",
  "version": "0.9.47",
  "description": "Fast, lightweight, and fully customizable music player for your desktop",
  "author": "Veno",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Veno89/Vplayer.git"
  },
  "private": true,
  "scripts": {
    "dev": "vite",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "test": "vitest run --pool=threads --maxWorkers=1 --no-file-parallelism",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:versions": "node scripts/check-version.mjs",
    "verify:frontend": "npm run typecheck && npm test && npm run build",
    "build": "vite build",
    "tauri:build": "tauri build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "lucide-react": "^0.563.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-window": "^1.8.7",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^25.0.9",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.14",
    "jsdom": "^22.1.0",
    "postcss": "^8.4.24",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^4.0.6"
  }
