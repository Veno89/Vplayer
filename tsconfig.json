{
    "compilerOptions": {
        "target": "ES2022",
        "useDefineForClassFields": true,
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "skipLibCheck": true,
        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noUncheckedSideEffectImports": true,
        "noEmit": true,
        "jsx": "react-jsx",
        "rootDir": "./src",
        "types": [
            "vite/client",
            "node",
            "vitest/globals",
            "@testing-library/jest-dom"
        ],
        /* Gradual migration - allow JS files */
        "allowJs": true,
        "checkJs": false,
        /* Linting */
        "strict": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "noFallthroughCasesInSwitch": true,
        /* Path mapping */
        "paths": {
            "@/*": [
                "./src/*"
            ]
        }
    },
    "include": [
        "src"
    ]
}
